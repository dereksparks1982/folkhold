{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "folkhold",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GLOBAL_CHAT",
        "class_name": "GlobalChat"
      }
    ]
  },
  "exports": {
    "GlobalChat": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://dereksparks1982.github.io",
    "PUBLIC_SITE_ORIGIN": "https://dereksparks1982.github.io/folkhold"
  }
}
